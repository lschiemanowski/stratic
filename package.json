{
  "name": "@lschiemanowski/stratic",
  "version": "0.1.0",
  "description": "Hierarchical program descriptions for people and coding agents",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "dist/main.cjs",
  "bin": {
    "stratic": "dist/cli.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "stratic": "node src/cli.ts",
    "build": "node scripts/build.ts",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "node scripts/demo.ts",
    "test:desktop": "npm run build && node scripts/desktop-smoke.ts",
    "prepack": "npm run build",
    "test:package": "node scripts/package-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "playwright-core": "1.62.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "katex": "0.18.7",
    "micromark-util-decode-string": "2.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "electron": "43.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lschiemanowski/stratic.git"
  },
  "homepage": "https://github.com/lschiemanowski/stratic#readme",
  "bugs": {
    "url": "https://github.com/lschiemanowski/stratic/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "skills/",
    "src/",
    "scripts/build.ts",
    "tsconfig.json",
    "docs/"
  ]
}
